python3 - << 'EOF' > u_shape_world.sdf

print('<?xml version="1.0" encoding="UTF-8"?>')
print('<sdf version="1.9">')
print('  <world name="u_shape_world">')

# =========================
# PHYSICS + ENVIRONMENT
# =========================
print('''
    <physics type="ode">
        <max_step_size>0.004</max_step_size>
        <real_time_factor>1.0</real_time_factor>
        <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>

    <!-- Earth magnetic field -->
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <!-- Atmosphere -->
    <atmosphere type="adiabatic"/>

    <!-- Geographic reference (Crucial for PX4 EKF) -->
    <spherical_coordinates>
        <surface_model>EARTH_WGS84</surface_model>
        <world_frame_orientation>ENU</world_frame_orientation>
        <latitude_deg>47.397971057728974</latitude_deg>
        <longitude_deg>8.546163739800146</longitude_deg>
        <elevation>0</elevation>
    </spherical_coordinates>

    <!-- SCENE -->
    <scene>
        <grid>true</grid>
        <ambient>0.8 0.8 0.8 1</ambient>
        <background>0.9 0.95 1.0 1</background>
        <shadows>true</shadows>
    </scene>

    <!-- STABLE SUN -->
    <light name="sun" type="directional">
        <pose>0 0 500 0 0 0</pose>
        <cast_shadows>true</cast_shadows>
        <intensity>1.5</intensity>
        <direction>-0.5 0.2 -1</direction>
        <diffuse>1 1 1 1</diffuse>
        <specular>0.5 0.5 0.5 1</specular>
    </light>
''')

# =========================
# GROUND
# =========================
print('''
    <model name="ground_plane">
        <static>true</static>

        <link name="link">

            <collision name="collision">
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>500 500</size>
                    </plane>
                </geometry>
            </collision>

            <visual name="visual">
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>500 500</size>
                    </plane>
                </geometry>

                <material>
                    <ambient>0.9 0.9 0.9 1</ambient>
                    <diffuse>0.9 0.9 0.9 1</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>

            </visual>

        </link>
    </model>
''')

# =========================
# U-SHAPED OBSTACLE
# =========================

u_walls = [
    ("u_wall_back", 4.0, 0.0, 1.5, 0.5, 4.5, 3.0),
    ("u_wall_left", 2.5, 2.0, 1.5, 3.0, 0.5, 3.0),
    ("u_wall_right", 2.5, -2.0, 1.5, 3.0, 0.5, 3.0),
]

for name, x, y, z, sx, sy, sz in u_walls:

    print(f'''
    <model name="{name}">
        <static>true</static>
        <pose>{x} {y} {z} 0 0 0</pose>

        <link name="link">

            <collision name="collision">
                <geometry>
                    <box>
                        <size>{sx} {sy} {sz}</size>
                    </box>
                </geometry>
            </collision>

            <visual name="visual">
                <geometry>
                    <box>
                        <size>{sx} {sy} {sz}</size>
                    </box>
                </geometry>

                <material>
                    <ambient>0.6 0.6 0.6 1</ambient>
                    <diffuse>0.7 0.7 0.7 1</diffuse>
                </material>

            </visual>

        </link>
    </model>
''')

# =========================
# GOAL MARKER
# =========================
print('''
    <model name="goal_marker">
        <static>true</static>
        <pose>7.0 0 1.5 0 0 0</pose>

        <link name="link">

            <!-- Smaller collision for smoother approach -->
            <collision name="collision">
                <geometry>
                    <cylinder>
                        <radius>0.3</radius>
                        <length>3.0</length>
                    </cylinder>
                </geometry>
            </collision>

            <visual name="visual">
                <geometry>
                    <cylinder>
                        <radius>0.4</radius>
                        <length>3.0</length>
                    </cylinder>
                </geometry>

                <!-- Bright Green -->
                <material>
                    <ambient>0.1 0.9 0.1 1</ambient>
                    <diffuse>0.2 1.0 0.2 1</diffuse>
                    <specular>0.5 0.9 0.5 1</specular>
                    <emissive>0.0 0.5 0.0 1</emissive>
                </material>

            </visual>

        </link>
    </model>
''')

print('  </world>')
print('</sdf>')

EOF
